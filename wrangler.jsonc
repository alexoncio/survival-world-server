{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "survival-world-rooms",
  "main": "worker.js",
  "compatibility_date": "2026-11-09",
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] }
  ]
}
